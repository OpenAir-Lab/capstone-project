#include <Wire.h>       // I2C Communication
#include "PCF8575.h"    // Keypad Driver
#include <TFT_eSPI.h>   // Display Driver
#include <SPI.h>

// ====================================================
//                1. CONFIGURATION
// ====================================================

// --- WIRING ---
#define MIC_PIN_PCF  4       // PTT Button is on PCF8575 Pin P4
#define I2C_SDA      21      // ESP32 Data Pin
#define I2C_SCL      22      // ESP32 Clock Pin

// --- I2C ADDRESSES ---
#define ADDR_KEYPAD  0x20    // PCF8575 Address
#define ADDR_ENCODER 0x3A    // Rotary Knob Address

// --- DISPLAY SETTINGS ---
#define TFT_GREY     0x5AEB  
#define SCREEN_ROT   3       // 3 = Landscape (USB right)

// --- SCHEDULER TIMING (Milliseconds) ---
// These determine how often we check hardware. Lower = Faster response.
#define INTERVAL_FAST_INPUT  30   // Keypad/Mic (Fast)
#define INTERVAL_ENCODER     50   // Rotary Knob (Medium)
#define INTERVAL_SLOW_TASKS  2000 // Battery/Temp (Slow)

// ====================================================
//                2. GLOBAL VARIABLES
// ====================================================

// Hardware Objects
TFT_eSPI tft = TFT_eSPI(); 
PCF8575 pcf(ADDR_KEYPAD);         

// Keypad Map (Rows P11-P8, Cols P12-P15)
int rowPins[4] = {11, 10, 9, 8};   
int colPins[4] = {12, 13, 14, 15}; 
const char keys[4][4] = {
  {'L', '1', '2', '3'}, 
  {'U', '4', '5', '6'}, 
  {'D', '7', '8', '9'}, 
  {'R', '*', '0', '#'}  
};

// --- SYSTEM STATE (The "Truth" of the radio) ---
enum PageState { PAGE_HOME, PAGE_RF, PAGE_AUD, PAGE_PWR };
PageState currentPage = PAGE_HOME; // Which screen are we looking at?

String inputBuffer = "";       // Stores typed numbers (e.g., "145")
float activeFrequency = 145.000; 
bool isEditingFreq = false;    // Are we typing a number right now?
bool isTransmitting = false;   // Is PTT pressed?
int batteryPercentage = 100;
int volumeLevel = 5;           // 0 to 10

// Menu Data
int menuIndex = 0; 
const char* menuItems[] = {"RF", "AUD", "PWR"};

// Memory for Debouncing (Prevents double-clicks)
char lastKeyPressed = 0;       
int lastEncoderValue = 0;      

// Scheduler Timers
unsigned long timerInput = 0;
unsigned long timerEncoder = 0;
unsigned long timerSlow = 0;

